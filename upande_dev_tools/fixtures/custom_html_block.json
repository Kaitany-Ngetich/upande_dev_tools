[
 {
  "doctype": "Custom HTML Block",
  "docstatus": 0,
  "name": "Dev Tools Navigation",
  "html": "<div class=\"dtn\">\n  <div class=\"dtn-hero\"><div class=\"dtn-hero-tt\">Upande Dev Tools</div><div class=\"dtn-hero-sub\">Requests &middot; Backlog &middot; Deployments &middot; Bench health</div></div>\n  <div class=\"dtn-title\">Portal</div>\n  <div class=\"dtn-grid\">\n  <a class=\"dtn-tile\" href=\"/backlog-board\"><span class=\"dtn-ic\" style=\"background:rgba(59,130,246,.13);color:#3b82f6\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"3\" y=\"3\" width=\"7\" height=\"7\" rx=\"1\"/><rect x=\"14\" y=\"3\" width=\"7\" height=\"7\" rx=\"1\"/><rect x=\"14\" y=\"14\" width=\"7\" height=\"7\" rx=\"1\"/><rect x=\"3\" y=\"14\" width=\"7\" height=\"7\" rx=\"1\"/></svg></span><span class=\"dtn-tx\"><span class=\"dtn-lb\">Backlog Board</span><span class=\"dtn-sub\">Tasks, issues &amp; requests</span></span></a>\n  <a class=\"dtn-tile\" href=\"/review-queue\"><span class=\"dtn-ic\" style=\"background:rgba(59,130,246,.13);color:#3b82f6\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"22 12 16 12 14 15 10 15 8 12 2 12\"/><path d=\"M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z\"/></svg></span><span class=\"dtn-tx\"><span class=\"dtn-lb\">Review Queue</span><span class=\"dtn-sub\">Triage incoming requests</span></span></a>\n  <a class=\"dtn-tile\" href=\"/requests-portal\"><span class=\"dtn-ic\" style=\"background:rgba(59,130,246,.13);color:#3b82f6\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M22 2 11 13\"/><path d=\"M22 2 15 22l-4-9-9-4z\"/></svg></span><span class=\"dtn-tx\"><span class=\"dtn-lb\">Raise a Request</span><span class=\"dtn-sub\">Customer/portal intake</span></span></a>\n  <a class=\"dtn-tile\" href=\"/my-backlog\"><span class=\"dtn-ic\" style=\"background:rgba(59,130,246,.13);color:#3b82f6\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><line x1=\"8\" y1=\"6\" x2=\"21\" y2=\"6\"/><line x1=\"8\" y1=\"12\" x2=\"21\" y2=\"12\"/><line x1=\"8\" y1=\"18\" x2=\"21\" y2=\"18\"/><line x1=\"3\" y1=\"6\" x2=\"3.01\" y2=\"6\"/><line x1=\"3\" y1=\"12\" x2=\"3.01\" y2=\"12\"/><line x1=\"3\" y1=\"18\" x2=\"3.01\" y2=\"18\"/></svg></span><span class=\"dtn-tx\"><span class=\"dtn-lb\">My Backlog</span><span class=\"dtn-sub\">Your open work &amp; meetings</span></span></a>\n  <a class=\"dtn-tile\" href=\"/pm-dashboard\"><span class=\"dtn-ic\" style=\"background:rgba(59,130,246,.13);color:#3b82f6\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m12 14 4-4\"/><path d=\"M3.34 19a10 10 0 1 1 17.32 0\"/></svg></span><span class=\"dtn-tx\"><span class=\"dtn-lb\">PM Dashboard</span><span class=\"dtn-sub\">Portfolio &amp; delivery metrics</span></span></a>\n  <a class=\"dtn-tile\" href=\"/dev-dashboard\"><span class=\"dtn-ic\" style=\"background:rgba(59,130,246,.13);color:#3b82f6\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M22 12h-4l-3 9L9 3l-3 9H2\"/></svg></span><span class=\"dtn-tx\"><span class=\"dtn-lb\">Dev Dashboard</span><span class=\"dtn-sub\">Bench health &amp; git state</span></span></a>\n  <a class=\"dtn-tile\" href=\"/master-data\"><span class=\"dtn-ic\" style=\"background:rgba(59,130,246,.13);color:#3b82f6\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><line x1=\"4\" y1=\"21\" x2=\"4\" y2=\"14\"/><line x1=\"4\" y1=\"10\" x2=\"4\" y2=\"3\"/><line x1=\"12\" y1=\"21\" x2=\"12\" y2=\"12\"/><line x1=\"12\" y1=\"8\" x2=\"12\" y2=\"3\"/><line x1=\"20\" y1=\"21\" x2=\"20\" y2=\"16\"/><line x1=\"20\" y1=\"12\" x2=\"20\" y2=\"3\"/><line x1=\"1\" y1=\"14\" x2=\"7\" y2=\"14\"/><line x1=\"9\" y1=\"8\" x2=\"15\" y2=\"8\"/><line x1=\"17\" y1=\"16\" x2=\"23\" y2=\"16\"/></svg></span><span class=\"dtn-tx\"><span class=\"dtn-lb\">Master Data</span><span class=\"dtn-sub\">Edit tags, types, priorities &amp; areas</span></span></a>\n  </div>\n  <div class=\"dtn-title\">Requests</div>\n  <div class=\"dtn-grid\">\n  <a class=\"dtn-tile\" href=\"/app/request\"><span class=\"dtn-ic\" style=\"background:rgba(34,197,94,.13);color:#16a34a\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"22 12 16 12 14 15 10 15 8 12 2 12\"/><path d=\"M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z\"/></svg></span><span class=\"dtn-tx\"><span class=\"dtn-lb\">Requests</span><span class=\"dtn-sub\">All raised requests</span></span></a>\n  <a class=\"dtn-tile\" href=\"/app/request-type\"><span class=\"dtn-ic\" style=\"background:rgba(34,197,94,.13);color:#16a34a\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12.586 2.586A2 2 0 0 0 11.172 2H4a2 2 0 0 0-2 2v7.172a2 2 0 0 0 .586 1.414l8.704 8.704a2.426 2.426 0 0 0 3.42 0l6.58-6.58a2.426 2.426 0 0 0 0-3.42z\"/><circle cx=\"7.5\" cy=\"7.5\" r=\"1.5\"/></svg></span><span class=\"dtn-tx\"><span class=\"dtn-lb\">Request Types</span><span class=\"dtn-sub\">Feature / Bug / Chore / \u2026</span></span></a>\n  </div>\n  <div class=\"dtn-title\">Deployments</div>\n  <div class=\"dtn-grid\">\n  <a class=\"dtn-tile\" href=\"/app/deployment-request\"><span class=\"dtn-ic\" style=\"background:rgba(245,158,11,.13);color:#d97706\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z\"/><path d=\"m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z\"/><path d=\"M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0\"/><path d=\"M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5\"/></svg></span><span class=\"dtn-tx\"><span class=\"dtn-lb\">Deployment Requests</span><span class=\"dtn-sub\">Ship an app to an instance</span></span></a>\n  <a class=\"dtn-tile\" href=\"/app/deployment-instance\"><span class=\"dtn-ic\" style=\"background:rgba(245,158,11,.13);color:#d97706\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"2\" y=\"2\" width=\"20\" height=\"8\" rx=\"2\"/><rect x=\"2\" y=\"14\" width=\"20\" height=\"8\" rx=\"2\"/><line x1=\"6\" y1=\"6\" x2=\"6.01\" y2=\"6\"/><line x1=\"6\" y1=\"18\" x2=\"6.01\" y2=\"18\"/></svg></span><span class=\"dtn-tx\"><span class=\"dtn-lb\">Deployment Instances</span><span class=\"dtn-sub\">Where things get deployed</span></span></a>\n  <a class=\"dtn-tile\" href=\"/app/deployment-app\"><span class=\"dtn-ic\" style=\"background:rgba(245,158,11,.13);color:#d97706\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z\"/><path d=\"M3.3 7 12 12l8.7-5\"/><path d=\"M12 22V12\"/></svg></span><span class=\"dtn-tx\"><span class=\"dtn-lb\">Deployment Apps</span><span class=\"dtn-sub\">Apps tracked for deployment</span></span></a>\n  </div>\n  <div class=\"dtn-title\">Bench Health</div>\n  <div class=\"dtn-grid\">\n  <a class=\"dtn-tile\" href=\"/app/module-version-check\"><span class=\"dtn-ic\" style=\"background:rgba(139,92,246,.13);color:#7c53e0\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><line x1=\"6\" y1=\"3\" x2=\"6\" y2=\"15\"/><circle cx=\"18\" cy=\"6\" r=\"3\"/><circle cx=\"6\" cy=\"18\" r=\"3\"/><path d=\"M18 9a9 9 0 0 1-9 9\"/></svg></span><span class=\"dtn-tx\"><span class=\"dtn-lb\">Module Version Check</span><span class=\"dtn-sub\">Git drift per installed app</span></span></a>\n  <a class=\"dtn-tile\" href=\"/app/code-backup-snapshot\"><span class=\"dtn-ic\" style=\"background:rgba(139,92,246,.13);color:#7c53e0\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z\"/><polyline points=\"17 21 17 13 7 13 7 21\"/><polyline points=\"7 3 7 8 15 8\"/></svg></span><span class=\"dtn-tx\"><span class=\"dtn-lb\">Code Backup Snapshots</span><span class=\"dtn-sub\">Point-in-time code backups</span></span></a>\n  <a class=\"dtn-tile\" href=\"/app/code-backup-settings\"><span class=\"dtn-ic\" style=\"background:rgba(139,92,246,.13);color:#7c53e0\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"3\"/><path d=\"M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z\"/></svg></span><span class=\"dtn-tx\"><span class=\"dtn-lb\">Code Backup Settings</span><span class=\"dtn-sub\">What &amp; when to back up</span></span></a>\n  <a class=\"dtn-tile\" href=\"/app/developer-activity-log\"><span class=\"dtn-ic\" style=\"background:rgba(139,92,246,.13);color:#7c53e0\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M22 12h-4l-3 9L9 3l-3 9H2\"/></svg></span><span class=\"dtn-tx\"><span class=\"dtn-lb\">Developer Activity Log</span><span class=\"dtn-sub\">Who changed what, and when</span></span></a>\n  <a class=\"dtn-tile\" href=\"/app/field-difference-log\"><span class=\"dtn-ic\" style=\"background:rgba(139,92,246,.13);color:#7c53e0\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M16 3h5v5\"/><path d=\"M8 3H3v5\"/><path d=\"M12 22v-8.3a4 4 0 0 0-1.17-2.83L3 3\"/><path d=\"m15 9 6-6\"/></svg></span><span class=\"dtn-tx\"><span class=\"dtn-lb\">Field Difference Log</span><span class=\"dtn-sub\">Local vs. live schema drift</span></span></a>\n  </div>\n  <div class=\"dtn-title\">Master Data (doctypes)</div>\n  <div class=\"dtn-grid\">\n  <a class=\"dtn-tile\" href=\"/app/priority-level\"><span class=\"dtn-ic\" style=\"background:rgba(100,116,139,.13);color:#64748b\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z\"/><line x1=\"4\" y1=\"22\" x2=\"4\" y2=\"15\"/></svg></span><span class=\"dtn-tx\"><span class=\"dtn-lb\">Priority Level</span><span class=\"dtn-sub\">Low/Medium/High/Urgent &amp; order</span></span></a>\n  <a class=\"dtn-tile\" href=\"/app/product-area\"><span class=\"dtn-ic\" style=\"background:rgba(100,116,139,.13);color:#64748b\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z\"/><path d=\"m22 17.65-9.17 4.16a2 2 0 0 1-1.66 0L2 17.65\"/><path d=\"m22 12.65-9.17 4.16a2 2 0 0 1-1.66 0L2 12.65\"/></svg></span><span class=\"dtn-tx\"><span class=\"dtn-lb\">Product Area</span><span class=\"dtn-sub\">Modules a request/task belongs to</span></span></a>\n  <a class=\"dtn-tile\" href=\"/app/work-tag\"><span class=\"dtn-ic\" style=\"background:rgba(100,116,139,.13);color:#64748b\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12.586 2.586A2 2 0 0 0 11.172 2H4a2 2 0 0 0-2 2v7.172a2 2 0 0 0 .586 1.414l8.704 8.704a2.426 2.426 0 0 0 3.42 0l6.58-6.58a2.426 2.426 0 0 0 0-3.42z\"/><circle cx=\"7.5\" cy=\"7.5\" r=\"1.5\"/></svg></span><span class=\"dtn-tx\"><span class=\"dtn-lb\">Work Tag</span><span class=\"dtn-sub\">The tag vocabulary tasks &amp; requests use</span></span></a>\n  <a class=\"dtn-tile\" href=\"/app/dev-portal-page\"><span class=\"dtn-ic\" style=\"background:rgba(100,116,139,.13);color:#64748b\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"3\" y=\"3\" width=\"7\" height=\"7\" rx=\"1\"/><rect x=\"14\" y=\"3\" width=\"7\" height=\"7\" rx=\"1\"/><rect x=\"14\" y=\"14\" width=\"7\" height=\"7\" rx=\"1\"/><rect x=\"3\" y=\"14\" width=\"7\" height=\"7\" rx=\"1\"/></svg></span><span class=\"dtn-tx\"><span class=\"dtn-lb\">Dev Portal Page</span><span class=\"dtn-sub\">Portal page registry &amp; nav roles</span></span></a>\n  </div>\n  </div>",
  "style": ".dtn{padding:4px 2px;font-family:'Poppins',var(--font-stack),'Inter',sans-serif;}\n.dtn-hero{margin:0 0 16px 2px;}\n.dtn-hero-tt{font-size:20px;font-weight:700;line-height:1.1;color:var(--heading-color,#1c1c1c);}\n.dtn-hero-sub{font-size:12px;color:#8a8f98;margin-top:3px;letter-spacing:.02em;}\n.dtn-title{font-size:11px;text-transform:uppercase;letter-spacing:.06em;color:#8a8f98;font-weight:600;margin:18px 0 10px 2px;}\n.dtn-title:first-of-type{margin-top:0;}\n.dtn-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:10px;}\n.dtn-tile{display:flex;align-items:center;gap:11px;padding:13px 15px;border:1px solid var(--border-color,#e2e4e9);border-radius:10px;background:var(--card-bg,#fff);text-decoration:none;color:inherit;transition:box-shadow .18s ease,transform .18s ease,border-color .18s ease;}\n.dtn-tile:hover{box-shadow:0 2px 8px rgba(0,0,0,.07);transform:translateY(-1px);border-color:var(--gray-300,#c9ced6);text-decoration:none;}\n.dtn-tile:hover .dtn-lb,.dtn-tile:hover .dtn-sub{text-decoration:none;}\n.dtn-ic{width:36px;height:36px;border-radius:9px;display:flex;align-items:center;justify-content:center;flex:0 0 auto;}\n.dtn-ic svg{width:18px;height:18px;}\n.dtn-tx{min-width:0;display:flex;flex-direction:column;}\n.dtn-lb{display:block;font-size:13.5px;font-weight:600;line-height:1.2;}\n.dtn-sub{display:block;font-size:11px;color:#8a8f98;line-height:1.3;margin-top:2px;}",
  "script": "(function() {\n  try {\n    if (!document.querySelector('link[data-dtn-poppins]')) {\n      var pf=document.createElement('link'); pf.rel='stylesheet'; pf.setAttribute('data-dtn-poppins','1');\n      pf.href='https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap';\n      document.head.appendChild(pf);\n    }\n  } catch(e){}\n})();",
  "private": 0,
  "roles": []
 }
]